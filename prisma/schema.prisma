generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PersonType {
  PF
  PJ
}

enum PersonRoleType {
  SUPPLIER
  CUSTOMER
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum BankAccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
}

enum PurchaseStatus {
  OPEN
  CANCELLED
}

model Person {
  id          String       @id @default(cuid())
  personType  PersonType
  legalName   String
  tradeName   String?
  cpfCnpj     String?      @unique
  rgIe        String?
  email       String?
  phone       String?
  zipCode     String?
  street      String?
  number      String?
  complement  String?
  district    String?
  city        String?
  state       String?
  notes       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roles       PersonRole[]
  purchases   Purchase[]

  @@index([legalName])
  @@index([active])
}

model PersonRole {
  personId String
  role     PersonRoleType
  person   Person         @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([personId, role])
  @@index([role])
}

model Broker {
  id         String     @id @default(cuid())
  personType PersonType
  name       String
  tradeName  String?
  cpfCnpj    String?    @unique
  rgIe       String?
  email      String?
  phone      String?
  pixKey     String?
  notes      String?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  purchases  Purchase[]

  @@index([name])
  @@index([active])
}

model Purchase {
  id                String          @id @default(cuid())
  sequence          Int             @unique
  date              DateTime
  supplierId        String
  supplier          Person          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kilograms         Decimal
  sacks             Decimal
  pricePerSack      Decimal
  grossAmount       Decimal
  adjustmentAmount  Decimal         @default(0)
  totalAmount       Decimal
  brokerId          String?
  broker             Broker?         @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  commissionPercent Decimal?
  commissionAmount  Decimal          @default(0)
  notes             String?
  status            PurchaseStatus   @default(OPEN)
  installments      PurchaseInstallment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([date])
  @@index([supplierId])
  @@index([brokerId])
  @@index([status])
}

model PurchaseInstallment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  number     Int
  dueDate    DateTime
  amount     Decimal
  paidAmount Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([purchaseId, number])
  @@index([dueDate])
}

model FinancialCategory {
  id          String       @id @default(cuid())
  code        String?      @unique
  name        String
  type        CategoryType
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, type])
  @@index([active])
}

model BankAccount {
  id             String          @id @default(cuid())
  bankCode       String?
  bankName       String
  agency         String?
  accountNumber  String
  accountDigit   String?
  type           BankAccountType
  description    String?
  // Prisma usa Decimal.js mesmo no SQLite; em produção o PostgreSQL usará NUMERIC(18,2).
  openingBalance Decimal         @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([bankName, agency, accountNumber, accountDigit])
  @@index([active])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  beforeData String?
  afterData  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
