generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PersonType {
  PF
  PJ
}

enum PersonRoleType {
  SUPPLIER
  CUSTOMER
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum BankAccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
}

model Person {
  id          String       @id @default(cuid())
  personType  PersonType
  legalName   String
  tradeName   String?
  cpfCnpj     String?      @unique
  rgIe        String?
  email       String?
  phone       String?
  zipCode     String?
  street      String?
  number      String?
  complement  String?
  district    String?
  city        String?
  state       String?
  notes       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roles       PersonRole[]

  @@index([legalName])
  @@index([active])
}

model PersonRole {
  personId String
  role     PersonRoleType
  person   Person         @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([personId, role])
  @@index([role])
}

model Broker {
  id         String     @id @default(cuid())
  personType PersonType
  name       String
  tradeName  String?
  cpfCnpj    String?    @unique
  rgIe       String?
  email      String?
  phone      String?
  pixKey     String?
  notes      String?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([name])
  @@index([active])
}

model FinancialCategory {
  id          String       @id @default(cuid())
  code        String?      @unique
  name        String
  type        CategoryType
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, type])
  @@index([active])
}

model BankAccount {
  id             String          @id @default(cuid())
  bankCode       String?
  bankName       String
  agency         String?
  accountNumber  String
  accountDigit   String?
  type           BankAccountType
  description    String?
  // Prisma usa Decimal.js mesmo no SQLite; em produção o PostgreSQL usará NUMERIC(18,2).
  openingBalance Decimal         @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([bankName, agency, accountNumber, accountDigit])
  @@index([active])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  beforeData String?
  afterData  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
